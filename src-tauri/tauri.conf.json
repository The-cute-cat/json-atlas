{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JSON Atlas",
  "version": "0.2.0",
  "identifier": "io.hopecat.jsonatlas",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "JSON Atlas",
        "width": 800,
        "height": 600,
        "minWidth": 640,
        "minHeight": 480,
        "dragDropEnabled": true,
        "center": true,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1420; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "The_cute_cat",
    "copyright": "Copyright © 2026 The_cute_cat and contributors",
    "shortDescription": "Local JSON and JSONL reader with an interactive tree canvas",
    "longDescription": "JSON Atlas reads JSON and JSONL files locally on an interactive tree canvas. Large files are indexed on disk and loaded by page; nothing is uploaded.",
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/app.ico",
      "icons/app.png"
    ],
    "fileAssociations": [
      {
        "ext": [
          "json",
          "jsonl",
          "ndjson",
          "jsonlines"
        ],
        "name": "JSONAtlas.Document",
        "description": "JSON Atlas structured data document",
        "role": "Viewer"
      }
    ],
    "resources": {
      "icons/document.ico": "document.ico"
    },
    "windows": {
      "wix": {
        "upgradeCode": "1d36a936-5fd6-5061-9069-87611655a266",
        "language": "zh-CN",
        "fragmentPaths": ["windows/file-associations.wxs"],
        "componentRefs": ["DocumentAssociations"]
      },
      "nsis": {
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  }
}
