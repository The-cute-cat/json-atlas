# Publish only these user-facing docs. Keep maintainer notes and local drafts ignored.
/docs/*
!/docs/README.es.md
!/docs/README.fr.md
!/docs/README.ja.md
!/docs/README.zh-CN.md
!/docs/guides/
/docs/guides/*
!/docs/guides/large-files.md

# Local references and design sources
/reference/
src-tauri/icons/*-source.png

# Generated large samples belong in /local-data/; regression fixtures in tests/ are source.

