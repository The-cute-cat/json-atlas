.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
.npmrc
.cargo/credentials
.cargo/credentials.toml

# Private samples and local working files
/local-data/
/private/
*.local
*.local.*
*.tmp
*.bak
**/temp
Thumbs.db
Desktop.ini

